{
  "general": {
    "launcherShortcut": "ctrl+space",
    "showInMenuBar": true,
    "automaticallyCheckForUpdates": true,
    "popToRootSeconds": 5,
    "escapeKeyBehavior": "navigateBackOrClose",
    "autoSwitchInputSource": "com.apple.keylayout.US",
    "supportReminders": true,
    "language": "en"
  },
  "appearance": {
    "theme": "system",
    "animations": true,
    "interfaceSize": "standard",
    "compactMode": false,
    "compactBarCommands": [
      "command:clipboard-history",
      "command:search-emoji",
      "command:search-files",
      "command:search-quicklinks"
    ],
    "followCursorAcrossDisplays": true,
    "dragToReposition": false
  },
  "hyperKey": {
    "key": "capsLock",
    "includesShift": true,
    "quickPress": "none",
    "secureInputCompatibility": false
  },
  "calculator": {
    "numberStyle": "system"
  },
  "search": {
    "showsSuggestions": true,
    "sensitivity": "medium"
  },
  "applications": {
    "enabled": true,
    "searchScopes": [
      "/Applications",
      "/Applications/Utilities",
      "/System/Applications",
      "/System/Applications/Utilities",
      "/System/Library/CoreServices/Applications",
      "/System/Volumes/Preboot/Cryptexes/App/System/Applications",
      "/System/Library/CoreServices/Finder.app",
      "~/Applications"
    ],
    "apps": {}
  },
  "systemSettings": {
    "enabled": true,
    "panes": {}
  },
  "systemActions": {
    "enabled": true,
    "actions": {}
  },
  "commands": {
    "builtInEnabled": true,
    "builtIn": {
      "define": {
        "shortcut": null,
        "alias": "define",
        "showInLauncher": true
      }
    },
    "enabled": true,
    "showInLauncher": true
  },
  "quicklinks": {
    "enabled": true,
    "showInLauncher": true,
    "opensNewWindow": false,
    "passesSelectedText": false,
    "confirmsBeforeDelete": true,
    "commands": {}
  },
  "appleShortcuts": {
    "enabled": false
  },
  "ai": {
    "enabled": true,
    "webSearch": false,
    "choices": true,
    "expandsReasoning": false,
    "systemPrompt": "",
    "systemPromptEnabled": true,
    "retentionDays": "forever",
    "opensTo": "recent",
    "newChatAfterMinutes": 5,
    "toolRounds": 25,
    "commands": {
      "ai-chat": {
        "shortcut": null,
        "alias": "ai",
        "showInLauncher": true
      }
    }
  },
  "quickActions": {
    "targetLanguage": "",
    "commands": {}
  },
  "dictation": {
    "mode": "toggle",
    "shortcut": null,
    "playsSounds": true,
    "model": "redux",
    "microphone": null,
    "destination": "paste",
    "adaptsCapitalization": true,
    "liveInsertion": false,
    "releaseAfterMinutes": 1,
    "language": null
  },
  "fileSearch": {
    "enabled": true,
    "scopes": [
      "~"
    ],
    "ignorePatterns": [
      "~/dev/go/pkg/mod",
      "~/go/pkg/mod",
      "~/Library/pnpm",
      "~/.rustup",
      "~/.cargo/registry",
      "~/.bun/install/cache"
    ],
    "removedDefaultPatterns": [],
    "showInLauncher": true,
    "commands": {}
  },
  "notes": {
    "enabled": false,
    "rendersMarkdown": true,
    "showsFormattingBar": true,
    "showsInMenuBar": false,
    "folder": null,
    "commands": {}
  },
  "snippets": {
    "showInLauncher": true,
    "folder": null,
    "commands": {}
  },
  "navigation": {
    "enabled": true,
    "menuSearchShowsAppleMenu": false,
    "menuSearchDisabledApps": [],
    "commands": {
      "switch-windows": {
        "shortcut": "hyper+tab",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "windowManagement": {
    "enabled": true,
    "showInLauncher": true,
    "gap": 0,
    "cycle": "sizes",
    "wrapDisplays": true,
    "keepProportions": true,
    "layoutsShowInLauncher": true,
    "roomsShowInLauncher": true,
    "shortcuts": {
      "left-half": "hyper+h",
      "right-half": "hyper+l",
      "top-half": "hyper+k",
      "bottom-half": "hyper+j",
      "top-left-quarter": null,
      "top-right-quarter": null,
      "bottom-left-quarter": null,
      "bottom-right-quarter": null,
      "first-three-fourths": null,
      "last-three-fourths": null,
      "first-third": null,
      "center-third": null,
      "last-third": null,
      "first-two-thirds": null,
      "last-two-thirds": null,
      "maximize": "hyper+m",
      "almost-maximize": null,
      "reasonable-size": "hyper+r",
      "maximize-height": null,
      "maximize-width": null,
      "center": "hyper+c",
      "center-half": null,
      "center-two-thirds": null,
      "make-larger": "hyper+=",
      "make-smaller": "hyper+-",
      "restore": "hyper+z",
      "move-left": "hyper+left",
      "move-right": "hyper+right",
      "move-up": "hyper+up",
      "move-down": "hyper+down",
      "move-to-left-edge": null,
      "move-to-right-edge": null,
      "move-to-top-edge": null,
      "move-to-bottom-edge": null,
      "next-display": "hyper+]",
      "previous-display": "hyper+[",
      "toggle-fullscreen": null,
      "previous-space": null,
      "next-space": null
    },
    "aliases": {},
    "customSizes": [],
    "layouts": [],
    "rooms": [],
    "commands": {}
  },
  "clipboard": {
    "enabled": true,
    "retentionDays": 90,
    "defaultAction": "copy",
    "disabledApps": [
      "com.apple.keychainaccess",
      "com.apple.Passwords"
    ],
    "commands": {
      "clipboard-history": {
        "shortcut": "shift+cmd+c",
        "alias": null,
        "showInLauncher": true
      },
      "paste-sequentially": {
        "shortcut": "hyper+v",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "emoji": {
    "skinTone": "none",
    "gridColumns": 8,
    "commands": {
      "search-emoji": {
        "shortcut": "ctrl+cmd+space",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "calendar": {
    "showInLauncher": true,
    "launcherLimit": 5,
    "span": "todayAndTomorrow",
    "joinWindowMinutes": 5,
    "autoJoinConfirms": true,
    "autoJoinNamedProvidersOnly": false,
    "meetingBrowser": null,
    "menuBar": "disabled",
    "menuBarUpcomingEvents": "today",
    "menuBarLinkedEventsOnly": true,
    "menuBarHidesWhenEmpty": false,
    "hideCurrentEventAfterMinutes": "never",
    "commands": {}
  },
  "extensions": {
    "showInLauncher": true
  }
}
