#!/usr/bin/env zsh
# Open the last Claude response from this pane's session in the default markdown
# app. Run it from the Claude prompt as `!preview` — the shell claude spawns
# inherits TMUX_PANE, which is the same key the Stop hook writes under.

if [[ -z "$TMUX_PANE" ]]; then
  echo "No TMUX_PANE — run this inside tmux." >&2
  exit 1
fi

POINTER="/tmp/claude-transcript-${TMUX_PANE}"

if [[ ! -f "$POINTER" ]]; then
  echo "No transcript pointer at $POINTER — has a response completed in this pane yet?" >&2
  exit 1
fi

TRANSCRIPT=$(<"$POINTER")

if [[ ! -f "$TRANSCRIPT" ]]; then
  echo "Transcript file not found: $TRANSCRIPT" >&2
  exit 1
fi

OUT="/tmp/claude-$(date +%Y%m%d-%H%M%S).md"

# Stream, don't slurp — transcripts reach tens of megabytes. Each assistant
# message's text blocks collapse to one JSON string per line, so the last line
# is the last response.
jq -c 'select(.type == "assistant")
       | ((.message.content? // []) | map(select(.type == "text").text) | join(""))
       | select(. != "")' "$TRANSCRIPT" \
  | tail -1 \
  | jq -r . > "$OUT"

if [[ ! -s "$OUT" ]]; then
  rm -f "$OUT"
  echo "No assistant text found in $TRANSCRIPT" >&2
  exit 1
fi

open "$OUT"
echo "$OUT"
