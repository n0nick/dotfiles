#!/usr/bin/env zsh
# Open one of this pane's Claude responses in the default markdown app.
# Run it from the Claude prompt as `!preview` — the shell claude spawns inherits
# TMUX_PANE, which is the same key the Stop hook writes under.
#
# Usage: preview [N]   N=1 (default) is the last response, 2 the one before it.
#
# For reading the latest response as it lands, the live page at
# ~/.claude/preview is usually the better tool; this is for pinning one
# response to a file you can keep, share, or diff.

if [[ -z "$TMUX_PANE" ]]; then
  echo "No TMUX_PANE — run this inside tmux." >&2
  exit 1
fi

POINTER="/tmp/claude-transcript-${TMUX_PANE}"

if [[ ! -f "$POINTER" ]]; then
  echo "No transcript pointer at $POINTER — has a response completed in this pane yet?" >&2
  exit 1
fi

TRANSCRIPT=$(<"$POINTER")
OUT="/tmp/claude-$(date +%Y%m%d-%H%M%S).md"

if ! "${0:A:h}/claude-turn" "$TRANSCRIPT" "${1:-1}" > "$OUT"; then
  rm -f "$OUT"
  exit 1
fi

open "$OUT"
echo "$OUT"
