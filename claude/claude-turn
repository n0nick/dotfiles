#!/usr/bin/env zsh
# claude-turn [-p] <transcript.jsonl> [N]        the Nth-from-last turn
# claude-turn [-p] --all <transcript.jsonl> [K]  the last K turns, newest first
#
# A turn is everything Claude said between two of your messages, so the short
# lines written before tool calls are kept, not just the final block.
#
# Two traps in the transcript format:
#   - tool results are stored as `user` entries, so a turn boundary is a user
#     entry NOT carrying one, or every tool call would split a turn;
#   - system-reminders are also `user` entries with plain string content, but
#     marked isMeta, and they'd split a turn just as wrongly.
#
# Both flags prepend your message to each turn; they differ in how:
#   -p  verbatim, separated from the response by --psep. For the reader, which
#       renders that half into its own container.
#   -q  as a markdown blockquote. For a file or clipboard, where there is no
#       container to render into.
#
# -q must prefix every line individually and keep the blank ones, or markdown
# swallows the whole message into a single run-on quote paragraph — your
# messages contain their own blockquotes and paragraph breaks.
#
# Turns are separated by an HTML comment: invisible when rendered, trivial to
# split on, harmless if the file is opened in a plain markdown app. --sep takes
# a caller-supplied one, which matters more than it sounds: a conversation
# about this script quotes the default separator in its own text, and the
# reader then splits a message in half. The hook passes a per-write nonce.

emulate -L zsh

SEP='<!--turn-->'
PSEP='<!--prompt-->'
PROMPT=false
QUOTE=false
ALL=false

while [[ "$1" == -* ]]; do
  case "$1" in
    -p|--prompt) PROMPT=true; shift ;;
    -q|--quote)  QUOTE=true; shift ;;
    --all)       ALL=true; shift ;;
    --sep)       SEP="$2"; shift 2 ;;
    --psep)      PSEP="$2"; shift 2 ;;
    *) echo "unknown flag: $1" >&2; exit 1 ;;
  esac
done

TRANSCRIPT="${1:?usage: claude-turn [-p] [--all] <transcript.jsonl> [N]}"
COUNT="${2:-1}"

[[ -f "$TRANSCRIPT" ]] || { echo "no such transcript: $TRANSCRIPT" >&2; exit 1 }
[[ "$COUNT" == <-> && $COUNT -ge 1 ]] || { echo "N must be a positive integer" >&2; exit 1 }

TMP=$(mktemp) || exit 1
trap 'rm -f "$TMP"' EXIT

# Boundaries come out as {"u":"<your message>"}, Claude's text as a bare JSON
# string — so a line starting with "{" is a boundary.
jq -c 'if (.type == "user"
           and ((.isMeta // false) | not)
           and ((.message.content | type == "string")
                or ((.message.content | map(.type) | index("tool_result")) == null)))
       then { u: (if (.message.content | type == "string")
                  then .message.content
                  else (.message.content | map(select(.type == "text").text) | join("")) end) }
       elif .type == "assistant"
       then ((.message.content? // []) | map(select(.type == "text").text) | join(""))
            | select(. != "")
       else empty end' "$TRANSCRIPT" > "$TMP" || exit 1

lines=("${(@f)$(<"$TMP")}")

# -r matters throughout: these are JSON strings, and print would eat the escapes.
decode() { print -lr -- "$@" | jq -sr 'join("\n\n")' }

# Walk backwards, closing a turn at each boundary. A turn's prompt is the
# boundary reached after its text.
typeset -a turns prompts block
for (( i = ${#lines[@]}; i > 0; i-- )); do
  if [[ "$lines[i]" == \{* ]]; then
    if (( ${#block[@]} )); then
      turns+=("$(decode $block)")
      prompts+=("$lines[i]")
      block=()
      (( ${#turns[@]} == COUNT )) && break
    fi
  else
    block=("$lines[i]" $block)
  fi
done

(( ${#turns[@]} )) || { echo "no turn $COUNT in $TRANSCRIPT" >&2; exit 1 }
$ALL || (( ${#turns[@]} == COUNT )) || { echo "only ${#turns[@]} turn(s) in $TRANSCRIPT" >&2; exit 1 }

emit() {
  local idx=$1 p
  local -a plines
  if $PROMPT || $QUOTE; then
    p=$(print -r -- "$prompts[idx]" \
        | jq -r '.u // ""' \
        | perl -0pe 's{<system-reminder>.*?</system-reminder>}{}gs; s/\A\s+//; s/\s+\z//')
    if [[ -n "$p" ]]; then
      if $QUOTE; then
        # Quoted (@f) keeps empty fields, so blank lines stay blank lines.
        plines=("${(@f)p}")
        print -rl -- ${plines/#/> }
      else
        print -r -- "$p"
        print -r -- ""
        print -r -- "$PSEP"
      fi
      print -r -- ""
    fi
  fi
  print -r -- "$turns[idx]"
}

if $ALL; then
  for (( n = 1; n <= ${#turns[@]}; n++ )); do
    (( n > 1 )) && { print -r -- ""; print -r -- "$SEP"; print -r -- "" }
    emit $n
  done
else
  emit $COUNT
fi
