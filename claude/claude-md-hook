#!/usr/bin/env zsh
# Hook for Stop, UserPromptSubmit, Notification and SessionEnd; it branches on
# hook_event_name.
#
# On Stop:
#   1. Record this session's transcript path, keyed by tmux pane, for `preview`.
#   2. Refresh this session's entry in the live reader at ~/.claude/preview.
#   3. Clear both markers.
# On UserPromptSubmit: mark working.
# On Notification: mark needs-you — Claude is asking for input or permission,
#   which reads as "working" otherwise, and that is the one state the reader
#   exists to distinguish.
# On SessionEnd: clear the markers, so a closed session does not sit there
#   apparently busy until its marker goes stale.
#
# The reader half runs in the background: it costs about half a second on a
# 50MB transcript, and nothing should wait on it to end a turn.
#
# This must print nothing on stdout: for UserPromptSubmit, anything written
# there is injected into the session's context.

INPUT=$(cat)
EVENT=$(print -r -- "$INPUT" | jq -r '.hook_event_name // empty')
TRANSCRIPT=$(print -r -- "$INPUT" | jq -r '.transcript_path // empty')

SESSIONS="$HOME/.claude/preview/sessions"

if [[ "$EVENT" == (UserPromptSubmit|Notification|SessionEnd) ]]; then
  ID="${TRANSCRIPT:t:r}"
  [[ -z "$ID" ]] && ID=$(print -r -- "$INPUT" | jq -r '.session_id // empty')
  [[ -d "$SESSIONS" && -n "$ID" ]] || exit 0
  case "$EVENT" in
    UserPromptSubmit) rm -f "$SESSIONS/${ID}.needs"; : > "$SESSIONS/${ID}.busy" ;;
    Notification)     rm -f "$SESSIONS/${ID}.busy";  : > "$SESSIONS/${ID}.needs" ;;
    SessionEnd)       rm -f "$SESSIONS/${ID}.busy" "$SESSIONS/${ID}.needs" ;;
  esac
  exit 0
fi

[[ -n "$TMUX_PANE" ]] && print -r -- "$TRANSCRIPT" > "/tmp/claude-transcript-${TMUX_PANE}"
[[ -n "$TRANSCRIPT" && -f "$TRANSCRIPT" ]] || exit 0
[[ -d "$SESSIONS" ]] || exit 0

# Clear the marker before the slow part, so the reader stops showing "working"
# as soon as the turn actually ends.
rm -f "$SESSIONS/${TRANSCRIPT:t:r}.busy" "$SESSIONS/${TRANSCRIPT:t:r}.needs"

{
  ID="${TRANSCRIPT:t:r}"

  # How you actually refer to a session: the name you gave it, else the one
  # Claude generated, else its opening line.
  #
  # custom-title is the authoritative record and carries its own sessionId,
  # which matters for forks: a forked session inherits the parent's
  # system-reminder announcing the parent's name, so reading that instead
  # labels the fork with the name of the session it came from.
  NAME=$(jq -r --arg id "$ID" \
           'select(.type == "custom-title" and .sessionId == $id) | .customTitle' \
           "$TRANSCRIPT" 2>/dev/null | tail -1)
  # Older sessions predate custom-title; fall back to the reminder.
  [[ -n "$NAME" ]] || NAME=$(jq -r 'select(.type == "user" and .isMeta == true)
                | select(.message.content | type == "string")
                | .message.content
                | capture("The user named this session \"(?<n>[^\"]+)\"").n' \
           "$TRANSCRIPT" 2>/dev/null | tail -1)
  [[ -n "$NAME" ]] || NAME=$(jq -rc 'select(.aiTitle) | .aiTitle' "$TRANSCRIPT" 2>/dev/null | tail -1)
  [[ -n "$NAME" ]] || NAME=$(jq -rc 'select(.type == "user") | select(.message.content | type == "string") | .message.content' \
                               "$TRANSCRIPT" 2>/dev/null | head -1 | cut -c1-60)
  [[ -n "$NAME" ]] || NAME="$ID"

  # The real path. The directory slug can't be trusted: dashes in it are
  # ambiguous between "/" and a literal "-", which is how viam/app reads as
  # viam-app and an email address shreds into path segments.
  PROJECT=$(jq -r 'select(.cwd) | .cwd' "$TRANSCRIPT" 2>/dev/null | tail -1)

  # A fresh separator each write. A conversation about this code quotes the
  # separator in its own text, and a fixed one would then split that message in
  # half when the page reads the file back.
  NONCE=$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')
  SEP="<!--turn-${NONCE}-->"
  PSEP="<!--prompt-${NONCE}-->"

  BODY=$("${0:A:h}/claude-turn" -p --all --sep "$SEP" --psep "$PSEP" "$TRANSCRIPT" 10 2>/dev/null) || exit 0
  [[ -n "$BODY" ]] || exit 0

  # When the session last spoke, not when this hook ran — otherwise a rebuild
  # restamps every session to the same minute and the recency sort collapses.
  UPDATED=$(date -u -r "$TRANSCRIPT" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) \
    || UPDATED=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  OUT="$SESSIONS/${ID}.md"
  {
    print -r -- "---"
    print -rn -- "name: ";    print -rn -- "${NAME//$'\n'/ }"    | jq -Rs .
    print -rn -- "project: "; print -rn -- "${PROJECT//$'\n'/ }" | jq -Rs .
    print -rn -- "updated: "; print -rn -- "$UPDATED" | jq -Rs .
    print -rn -- "sep: ";     print -rn -- "$SEP" | jq -Rs .
    print -rn -- "psep: ";    print -rn -- "$PSEP" | jq -Rs .
    print -r -- "---"
    print -r -- ""
    print -r -- "$BODY"
  } > "$OUT.tmp" && mv -f "$OUT.tmp" "$OUT"

  # Age the file to match the session, so the 7-day prune below measures real
  # inactivity rather than time since the last rebuild.
  touch -r "$TRANSCRIPT" "$OUT" 2>/dev/null

  # Sessions you haven't touched in a week stop being "live". Markers outlive
  # their turn only when a session is interrupted or killed, so they go sooner.
  find "$SESSIONS" -name '*.md' -mtime +7 -delete 2>/dev/null
  find "$SESSIONS" -name '*.busy' -mmin +60 -delete 2>/dev/null
  # needs-you is a real state that can last hours, so it expires far later.
  find "$SESSIONS" -name '*.needs' -mmin +720 -delete 2>/dev/null
} &!
